{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt --all -- --check)",
      "Bash(cargo check --workspace)",
      "Bash(cargo test --workspace)",
      "Bash(cargo clippy --workspace --all-targets -- -D warnings)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ]
  }
}
